# Groq API Key (free tier at console.groq.com)
# If omitted or empty, the app runs in deterministic offline fallback mode so demos always work.
GROQ_API_KEY=

# Groq Model Defaults
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Safety & Compliance Gates
DRY_RUN=true
LEGAL_REVIEWED_TEMPLATES=false

# Pacing & Caps
DAILY_CAP=30
SEND_SPACING_SECONDS=45
WARMUP_TIER=1

# Mandatory DPDP Act Notice Disclosures (Section 5)
SENDER_NAME=Aakash Verma
SENDER_COMPANY=RegulationFlow Technologies Pvt. Ltd.
SENDER_ROLE=Solutions Lead - DPDPFlow
SENDER_EMAIL=aakash@dpdpflow.com
SENDER_ADDRESS=Level 4, HustleHub Tech Park, HSR Layout, Bengaluru 560102, India
SENDING_DOMAIN=mail.dpdpflow.com
CALENDAR_URL=https://cal.com/dpdpflow/compliance-audit-demo

# Retention & Minimisation
RETENTION_DAYS=90

# Public Service URLs
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Optional Live SMTP (only used when DRY_RUN=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
